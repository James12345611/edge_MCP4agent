%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryTextColor": "#17202a", "lineColor": "#374151"}}}%%
flowchart LR
  subgraph AgentHost["企业批准的本地 Agent 进程"]
    AGENT["Agent / MCP Host"]
    MCP["MCP Adapter<br/>21 个浏览器工具"]
    CLIENT["AttachClient<br/>请求关联与超时"]
    AGENT -->|"MCP stdio"| MCP
    MCP --> CLIENT
  end

  subgraph Local["当前 Windows 用户本机"]
    CONFIG["本机配置<br/>端口、Token、扩展 ID"]
    HUB["Loopback Hub<br/>鉴权、句柄、租约、串行队列"]
    CLIENT -->|"WebSocket /client<br/>Bearer Token"| HUB
    CONFIG --> CLIENT
    CONFIG --> HUB
  end

  subgraph Edge["Microsoft Edge"]
    EXT["MV3 Extension<br/>用户 Grant + CDP Controller"]
    TAB["用户主动共享的<br/>HTTP(S) 标签页"]
    EXT <-->|"chrome.debugger / CDP<br/>受控操作与观察"| TAB
  end

  CONFIG -->|"生成配对配置"| EXT
  HUB <-->|"WebSocket /extension<br/>固定 Origin + hello Token"| EXT
  USER["用户"] -->|"共享 / 撤销<br/>1-480 分钟"| EXT
  PAGE["公网或内网页面"] -->|"正常浏览器网络"| TAB

  classDef trusted fill:#e7f6ec,stroke:#267a45,color:#173b25
  classDef transport fill:#e8f1fb,stroke:#2b67a0,color:#18344f
  classDef user fill:#fff1db,stroke:#a96816,color:#51360f
  class AGENT,MCP,CLIENT,HUB trusted
  class CONFIG,EXT transport
  class USER,TAB,PAGE user
