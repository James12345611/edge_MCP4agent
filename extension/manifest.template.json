{
  "manifest_version": 3,
  "name": "Enterprise Browser MCP",
  "version": "0.2.0",
  "description": "Share selected Edge tabs with the enterprise MCP for reading and interaction.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Enterprise Browser MCP"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:47832"
  }
}
